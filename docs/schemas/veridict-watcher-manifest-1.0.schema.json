{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goun7.github.io/veridict/schemas/veridict-watcher-manifest-1.0.schema.json",
  "title": "Veridict WatcherManifest (Standard v1.0.0-draft, \u00a76.1-\u00a76.2)",
  "description": "The manifest every watcher publishes. Structural ceiling: max_tier may never be W1a \u2014 test execution is machine-verifiable ground truth reserved to the \u00a77 ladder.",
  "type": "object",
  "required": [
    "watcher_id",
    "name",
    "version",
    "producer",
    "capabilities",
    "resource_class",
    "integrity"
  ],
  "additionalProperties": false,
  "properties": {
    "watcher_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "description": "No anonymous watchers (\u00a76.2).",
      "required": [
        "identity",
        "maintainer"
      ],
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "maintainer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": [
        "evidence_classes",
        "max_tier",
        "subscribes_to"
      ],
      "additionalProperties": false,
      "properties": {
        "evidence_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "TEST_EXECUTION",
              "REPRODUCIBLE_RUN",
              "FORMAL_PROOF",
              "STATIC_ANALYSIS",
              "JURY_OPINION",
              "WATCHER_REPORT"
            ],
            "description": "Canonical set defined by the core (veridict/schemas.py: EVIDENCE_CLASSES)."
          }
        },
        "max_tier": {
          "type": "string",
          "enum": [
            "W1b",
            "W2",
            "W3"
          ],
          "description": "W1a is forbidden to watchers by design (\u00a76.2)."
        },
        "subscribes_to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "resource_class": {
      "type": "object",
      "required": [
        "timeout_seconds",
        "sandbox_level"
      ],
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cost_budget": {
          "type": [
            "number",
            "null"
          ]
        },
        "sandbox_level": {
          "type": "string",
          "enum": [
            "none",
            "inprocess",
            "process",
            "container",
            "vm"
          ],
          "description": "inprocess = runs in the orchestrator's interpreter (shipped watchers); the orchestrator MAY sandbox others."
        }
      }
    },
    "integrity": {
      "type": "object",
      "description": "code_hash is the sha256 hex of the watcher's code; the orchestrator refuses a module whose hash does not match.",
      "required": [
        "code_hash",
        "update_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "code_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "update_policy": {
          "type": "string",
          "minLength": 1,
          "description": "pinned = new code means a NEW manifest with a new code_hash; floating = the registry re-pins on updates. Certification-time code review (\u00a75.5) applies either way."
        }
      }
    }
  }
}